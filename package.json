  "scripts": {
    "dev": "tsc -b && node .",
    "build": "tsc -b",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -b",
    "clean": "rm dist/types*; rm -rf dist/main; rm -rf dist/www/lib; rm -rf dist/www/index.{js,d.ts,d.ts.map}; rm -rf targets",
    "test": "npm run compile && node . --debug",
    "test:node": "npm run compile && node . --debug",
    "start": "npm run run:node",
    "start:node": "npm run run:node",
    "run": "npm run compile && node .",
    "run:node": "npm run compile && node ."
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.0",
